#!/bin/bash

set -eu

<% active_key = p('credhub.encryption.keys').flatten.find { |key| key.key?('active') } %>
<% active_provider_name = active_key['provider_name'] %>
<% active_provider = p('credhub.encryption.providers').flatten.find { |provider| provider['name'] == active_provider_name } %>

<% if active_provider['type'] == 'hsm' %>
    <% ha_group_label = active_provider['connection_properties']['partition'] %>
    # The Luna client is supplied by the operator and is not in credhub's `packages:` list, so
    # BOSH does not guarantee it is linked here. Without this guard an absent client would abort
    # drain with 127 under `set -eu`, wedging the very deploy that would fix the configuration.
    if [ -x /var/vcap/packages/luna-hsm-client/bin/64/lunacm ]; then
      PATH=$PATH:/var/vcap/packages/luna-hsm-client/bin/64
      lunacm -q haGroup deleteGroup -label <%= ha_group_label %> > /dev/null
    else
      echo "No Luna HSM client at /var/vcap/packages/luna-hsm-client; skipping HA group teardown." >&2
    fi
<% end %>

# Drain scripts must print a number to stdout:
# https://bosh.io/docs/drain.html
echo 0
