#!/bin/bash

set -eu

LOG_DIR=/var/vcap/sys/log/credhub
source /var/vcap/jobs/credhub/bin/utils.sh

tee_output_to_sys_log "${LOG_DIR}" "configure_hsm"

<%
  hsm_provider = p('credhub.encryption.providers').flatten.find  { |provider| provider['type'] == "hsm" }
  if hsm_provider
    if hsm_provider.has_key?("connection_properties")
      hsm_provider = hsm_provider["connection_properties"]
    end
    hsm_servers = hsm_provider['servers']
%>

# The Luna client is supplied by the operator, not by this release. It is not in credhub's
# `packages:` list -- it comes from a different release -- so BOSH neither resolves it nor fails
# the deploy when it is absent. These checks are the only guard on that dependency.
if [ ! -d /var/vcap/packages/luna-hsm-client ]; then
  echo "CredHub is configured to use an HSM encryption provider, but no Luna HSM client is installed at /var/vcap/packages/luna-hsm-client. Deliver the client as a BOSH release carrying a package named luna-hsm-client: for a CredHub deployment, upload that release and register a runtime config adding its job to the credhub job; for a CredHub colocated on a Director VM, colocate its job in the bosh create-env manifest, which has no runtime configs. See docs/configure-luna-hsm.md." >&2
  exit 1
fi

if [ ! -f /var/vcap/packages/luna-hsm-client/libs/64/libCryptoki2.so ]; then
  echo "CredHub is configured to use an HSM encryption provider, but libCryptoki2.so was not found at /var/vcap/packages/luna-hsm-client/libs/64/libCryptoki2.so. The luna-hsm-client package must lay the vendor client out as libs/64/libCryptoki2.so, bin/64/, jsp/LunaProvider.jar and jsp/64/libLunaAPI.so." >&2
  exit 1
fi

if [ ! -x /var/vcap/packages/luna-hsm-client/bin/64/lunacm ]; then
  echo "CredHub is configured to use an HSM encryption provider, but no executable lunacm was found at /var/vcap/packages/luna-hsm-client/bin/64/lunacm. CredHub uses it to bootstrap the HA partition group, so the vendor client's bin/64 directory must be packaged with its execute bits intact." >&2
  exit 1
fi

if [ ! -f /var/vcap/packages/luna-hsm-client/jsp/LunaProvider.jar ]; then
  echo "CredHub is configured to use an HSM encryption provider, but LunaProvider.jar was not found at /var/vcap/packages/luna-hsm-client/jsp/LunaProvider.jar. The luna-hsm-client package must include the vendor client's jsp directory." >&2
  exit 1
fi

if [ ! -f /var/vcap/packages/luna-hsm-client/jsp/64/libLunaAPI.so ]; then
  echo "CredHub is configured to use an HSM encryption provider, but libLunaAPI.so was not found at /var/vcap/packages/luna-hsm-client/jsp/64/libLunaAPI.so. The luna-hsm-client package must include the vendor client's jsp/64 directory." >&2
  exit 1
fi

if [ ! -f /var/vcap/packages/luna-hsm-client/openssl.cnf ]; then
  echo "CredHub is configured to use an HSM encryption provider, but openssl.cnf was not found at /var/vcap/packages/luna-hsm-client/openssl.cnf. The 10.9.3 Minimal and Universal clients both ship it at the client root, so a package built by untarring one of those with --strip-components=1 satisfies this as-is. Other flavours move it -- DPoD's cvclient-min uses etc/openssl.cnf, and the 7.4 Minimal Client used bin/64. If yours does, whoever builds the luna-hsm-client package must move it to the package root." >&2
  exit 1
fi

cat > /var/vcap/jobs/credhub/config/client_cert.pem <<EOL
<%= hsm_provider['client_certificate'] %>
EOL

cat > /var/vcap/jobs/credhub/config/client_key.pem <<EOL
<%= hsm_provider['client_key'] %>
EOL

cat > /var/vcap/jobs/credhub/config/hsm_cert.pem <<EOL
<% hsm_servers.each do |hsm| %>
<%= hsm['certificate'] %>
<% end %>
EOL

ln -f -s /var/vcap/jobs/credhub/config/encryption.conf /etc/Chrystoki.conf

<%
  primary_server = hsm_servers.shift
  primary_serial_number = primary_server['partition_serial_number']
  ha_group_label = hsm_provider['partition']
%>

PATH=$PATH:/var/vcap/packages/luna-hsm-client/bin/64

if ! lunacm -q haGroup listGroups -group "<%= ha_group_label %>" -password ""; then
  echo "HSM HA appears to be uninitialized. Performing HA HSM setup."

  echo "Creating new HSM HA group."

  # TODO: what is up with "echo copy" in these commands?
  NEW_GROUP_OUTPUT=$(echo copy | lunacm -q haGroup createGroup -label "<%= ha_group_label %>" -serialNumber <%= primary_serial_number %> -password <%= hsm_provider['partition_password'] %>)
  GROUPID=$(echo $NEW_GROUP_OUTPUT | grep -o -E 'HA Group Number: .*' | awk '{print $4}')

  echo "Adding members to HSM HA group."

<% hsm_servers.each do |hsm_server| %>
  echo "Adding server with partition serial number <%= hsm_server['partition_serial_number'] %> to HSM HA group."

  echo copy | lunacm -q haGroup addMember -group $GROUPID -serialNumber <%= hsm_server['partition_serial_number'] %> -password <%= hsm_provider['partition_password'] %>
<% end %>

  echo "Finished adding members to HSM HA group."

  echo "Synchronizing HSM HA group."
  lunacm -q haGroup synchronize -group $GROUPID -password <%= hsm_provider['partition_password'] %>
else
  echo "HSM HA appears to be initialized. Skipping HSM HA setup."
fi

<% end %>
